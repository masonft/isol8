{
  "name": "isol8",
  "short_name": "isol8",
  "description": "Find a song's repeated sections, flip one over the other, and hear what's left. Runs entirely on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#06070c",
  "theme_color": "#06070c",
  "categories": ["music", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "audio/*": [".mp3", ".flac", ".wav", ".aif", ".aiff", ".ogg", ".opus", ".m4a"] }
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "audio", "accept": ["audio/*", ".mp3", ".flac", ".wav", ".aif", ".aiff", ".ogg", ".opus", ".m4a"] }
      ]
    }
  }
}
